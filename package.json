{
  "name": "botox",
  "displayName": "Botox - Markdown Preview & Typesetting",
  "description": "Live preview and publication-grade LaTeX typesetting for Markdown documents and slide decks using Botox.",
  "version": "0.14.1",
  "publisher": "botoxMD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/botoxMD/botox-vsc-ext.git"
  },
  "bugs": {
    "url": "https://github.com/botoxMD/botox-vsc-ext/issues"
  },
  "homepage": "https://github.com/botoxMD/botox-vsc-ext#readme",
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "botox",
    "markdown",
    "latex",
    "typesetting",
    "pdf",
    "typst",
    "slides",
    "preview"
  ],
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onCommand:botox.openPreview",
    "onCommand:botox.compilePdf",
    "onCommand:botox.initDocument",
    "onCommand:botox.initSlides",
    "onCommand:botox.setup",
    "onCommand:botox.setupTerminal",
    "onCommand:botox.resetSetup"
  ],
  "contributes": {
    "commands": [
      {
        "command": "botox.setup",
        "title": "Configure Defaults (Setup Wizard)",
        "category": "Botox",
        "icon": "$(gear)"
      },
      {
        "command": "botox.resetSetup",
        "title": "Reset Setup Status (Force Setup on Next Run)",
        "category": "Botox"
      },
      {
        "command": "botox.setupTerminal",
        "title": "Run Setup in Terminal",
        "category": "Botox",
        "icon": "$(terminal)"
      },
      {
        "command": "botox.openPreview",
        "title": "Open Live PDF Preview",
        "category": "Botox",
        "icon": "$(open-preview)"
      },
      {
        "command": "botox.compilePdf",
        "title": "Compile to PDF",
        "category": "Botox",
        "icon": "$(file-pdf)"
      },
      {
        "command": "botox.initDocument",
        "title": "Initialize New Document",
        "category": "Botox"
      },
      {
        "command": "botox.initSlides",
        "title": "Initialize Slide Deck",
        "category": "Botox"
      },
      {
        "command": "botox.toggleSyncScroll",
        "title": "Toggle Follow Cursor / Sync Scroll",
        "category": "Botox"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "botox.openPreview",
          "when": "resourceLangId == markdown || editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "botox.compilePdf",
          "when": "resourceLangId == markdown || editorLangId == markdown",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "botox.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "7_modification@1"
        },
        {
          "command": "botox.compilePdf",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "7_modification@2"
        }
      ],
      "editor/context": [
        {
          "command": "botox.openPreview",
          "when": "editorLangId == markdown",
          "group": "1_modification@1"
        },
        {
          "command": "botox.compilePdf",
          "when": "editorLangId == markdown",
          "group": "1_modification@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "botox.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "botox.compilePdf",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Botox",
      "properties": {
        "botox.executablePath": {
          "type": "string",
          "default": "botox",
          "description": "Path to the botox CLI executable (defaults to 'botox' on PATH, or ~/.local/bin/botox)."
        },
        "botox.autoCompileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically recompile the preview when saving the active Markdown document."
        },
        "botox.autoCompileOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update the live preview on text changes before saving (debounced)."
        },
        "botox.debounceDelay": {
          "type": "number",
          "default": 120,
          "description": "Delay in milliseconds to wait after the last keystroke before recompiling the live preview."
        },
        "botox.bibliography": {
          "type": "boolean",
          "default": true,
          "description": "Transform web links into an automatic IEEE-standard bibliography in documents."
        },
        "botox.syncScroll": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize preview scroll and position to follow the editor cursor."
        },
        "botox.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Display compilation status and quick-preview toggle in the VS Code status bar."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "botox.gettingStarted",
        "title": "Getting Started with Botox",
        "description": "Configure your typesetting defaults and start writing publication-grade Markdown documents.",
        "steps": [
          {
            "id": "botox.walkthrough.setup",
            "title": "Configure Defaults",
            "description": "Run the interactive wizard to set your default author name, themes, and paper size.\n[Configure Defaults](command:botox.setup)\n[Run in Terminal](command:botox.setupTerminal)",
            "media": {
              "markdown": "media/walkthrough-setup.md"
            }
          },
          {
            "id": "botox.walkthrough.init",
            "title": "Create Document or Slides",
            "description": "Scaffold a new document or slide deck with your chosen defaults prefilled.\n[Initialize Document](command:botox.initDocument)\n[Initialize Slides](command:botox.initSlides)",
            "media": {
              "markdown": "media/walkthrough-init.md"
            }
          },
          {
            "id": "botox.walkthrough.preview",
            "title": "Live Preview & Typesetting",
            "description": "Typeset and view your document in real time with synchronized scrolling.\n[Open Live Preview](command:botox.openPreview)",
            "media": {
              "markdown": "media/walkthrough-preview.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
